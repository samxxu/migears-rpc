{
    "name": "migears/rpc",
    "description": "Minimalist JSON-RPC 2.0 client and server",
    "type": "library",
    "license": "MIT",
    "version": "2.0.0",
    "keywords": [
        "json-rpc",
        "rpc",
        "api",
        "migears"
    ],
    "require": {
        "php": "^8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^10"
    },
    "autoload": {
        "psr-4": {
            "MiGears\\Rpc\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "MiGears\\Rpc\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    }
}
